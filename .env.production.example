# Production template for Alvaro's hosted instance (Phase 4 dark deploy).
# Copy to .env on the server, then `php artisan key:generate`. No real secrets here.
# See DEPLOYMENT.md.

APP_NAME="Nexo Short"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nexoshort.alvarocdev.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Database (Hostinger MySQL — set the real prod credentials from hPanel) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# --- Sessions: secure cookie on HTTPS ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# --- Mail (Hostinger SMTP; Laravel >=13 uses MAIL_SCHEME, not MAIL_ENCRYPTION) ---
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="no-reply@nxo.li"
MAIL_FROM_NAME="${APP_NAME}"

# --- Trusted proxies (REQUIRED behind Cloudflare — see DEPLOYMENT.md / security review) ---
# Cloudflare IP ranges, or '*' when the Hostinger origin accepts traffic ONLY through Cloudflare.
TRUSTED_PROXIES=*

# --- Trusted hosts allowlist (defense in depth) ---
# Answer ONLY on NEXO_SHORT_HOST + NEXO_PANEL_HOST (and their www.); reject Host
# spoofing / cache poisoning. Safe behind Cloudflare.
TRUST_HOSTS_ENABLED=true

# =====================================================================
# Nexo Short instance contract
# =====================================================================
NEXO_SHORT_HOST=nxo.li
NEXO_PANEL_HOST=nexoshort.alvarocdev.com

# Dark deploy: standalone auth, registration CLOSED (no public signup yet;
# Phase 5 switches the hosted instance to SSO-only via Nexo ID).
NEXO_AUTH_MODE=local
NEXO_ALLOW_REGISTRATION=false

# --- Nexo ID SSO. Keep OFF for the dark deploy; flip to true at Phase 5 launch. ---
# IMPORTANT: the client is registered on the provider with a redirect URI on the
# PANEL host (https://nexoshort.alvarocdev.com/auth/nexo/callback). nxo.li is
# cookieless (ADR-001) and cannot serve the OIDC callback. Coordinate the exact
# redirect URI with Nexo ID before enabling.
NEXO_SSO_ENABLED=false
NEXO_SSO_ISSUER=https://nexoid.alvarocdev.com
NEXO_SSO_CLIENT_ID=019f8786-623f-7332-a12c-ac890711fb84
# Silent SSO (prompt=none) rides NEXO_SSO_ENABLED; set false to kill-switch it per tool.
NEXO_SSO_SILENT=true
NEXO_SSO_TIMEOUT=5
# Where Nexo ID returns the browser after a central (RP-initiated) logout. Register
# this exact URI on the provider or it lands on Nexo ID's own "signed out" page.
NEXO_SSO_POST_LOGOUT_REDIRECT_URI=https://nexoshort.alvarocdev.com

NEXO_SLUG_MIN_LENGTH=6
NEXO_SLUG_MAX_LENGTH=7

NEXO_ATTRIBUTION_ENABLED=true
# `TEXT` drives the minimal short-host footer; `LABEL` is the canonical ecosystem
# powered-by shown in the panel's nexo-footer (the full phrase — nothing is
# prepended to it). A third-party instance must set its own, never these.
NEXO_ATTRIBUTION_TEXT="Powered by alvarocdev.com"
NEXO_ATTRIBUTION_LABEL="powered by alvarocdev.com"
NEXO_ATTRIBUTION_URL="https://alvarocdev.com/?utm_source=nexo-short&utm_medium=powered-by"

# --- Nexo ecosystem chrome (shared header/app-switcher/footer, panel host) ---
# Which tool this is (marks it current in the app-switcher).
NEXO_ECOSYSTEM_CURRENT=nexoshort
# Hub + developer entry points (env-overridable so self-hosters can repoint).
NEXO_HUB_URL=https://nexotools.alvarocdev.com
NEXO_GITHUB_ORG=https://github.com/nexo-tools
# Cookieless ecosystem analytics (opt-in, panel host only). Off by default; when
# true, an anonymous pageview beacon is sent to the Nexo Tools hub.
NEXO_BEACON_ENABLED=false
# Help center contact (mailto: is used when no support URL is set).
NEXO_SUPPORT_URL=
NEXO_SUPPORT_EMAIL=hola@alvarocdev.com

# --- Anti-abuse (ADR-005) ---
NEXO_CREATE_RATE_PER_USER=10
NEXO_CREATE_RATE_PER_IP=20
NEXO_REPORT_RATE_PER_IP=5
# Recommended for the public instance; a flagged URL is rejected. Empty = disabled.
NEXO_SAFE_BROWSING_KEY=
NEXO_SAFE_BROWSING_FAIL_CLOSED=false
