includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - database
        - routes
    # The nexo-sso-client template is canonical and must not be modified from here
    # (its README hard rule). It omits iterable value-type docblocks that level 6
    # flags; ignored here rather than forking the template. Proposed upstream to
    # nexo-id/standards.
    ignoreErrors:
        -
            identifier: missingType.iterableValue
            path: app/Services/NexoSso/NexoSsoUserResolver.php
