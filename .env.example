APP_NAME="Nexo Short"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Shared dev environment (~/dev-environment): MySQL on standard port 3306,
# --- fixed local credentials dev/dev, one database per project. From the Sail
# --- app container the host is host.docker.internal. Tests use SQLite :memory:
# --- (phpunit.xml), never this connection.
# Database. The values below target the shared local Docker stack `nexo`
# (MySQL on host port 3307); this repo's compose.yaml only runs the app runtime,
# so the database is reached through host.docker.internal.
# SELF-HOSTING: point these at your own MySQL — see DEPLOYMENT.md.
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3307
DB_DATABASE=nexo_short
DB_USERNAME=dev
DB_PASSWORD=dev

SESSION_DRIVER=database
SESSION_LIFETIME=120
# The session payload carries the OIDC id_token used for RP-initiated logout
# (NexoSsoController), so it is encrypted at rest: with the database driver the
# raw token would otherwise sit readable in the sessions table (2026-08-02).
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies are http-only and same-site=lax by default. Set true in production
# (HTTPS) so the session cookie is only sent over TLS.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail: shared dev Mailpit (SMTP 1025, UI http://localhost:8025) ---
MAIL_MAILER=smtp
MAIL_HOST=host.docker.internal
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@nxo.li"
MAIL_FROM_NAME="${APP_NAME}"

# --- Sail runtime (app container only; DB/mail are shared, not here) ---
APP_PORT=8102
VITE_PORT=5177
WWWUSER=1000
WWWGROUP=1000

# --- Trusted proxies (REQUIRED in production behind Cloudflare) ---
# Without this, $request->ip() is Cloudflare's edge IP and every per-IP rate
# limit collapses to one bucket. Set to Cloudflare's IP ranges, or '*' when the
# origin accepts traffic ONLY through Cloudflare. Leave empty in local/dev.
TRUSTED_PROXIES=

# --- Trusted hosts allowlist (optional; recommended in production) ---
# When true, the app answers ONLY on NEXO_SHORT_HOST and NEXO_PANEL_HOST (each
# with an optional www.), rejecting Host-header spoofing. Off by default and
# always skipped in the local env + tests, so local/dev keeps working as-is.
TRUST_HOSTS_ENABLED=false

VITE_APP_NAME="${APP_NAME}"

# =====================================================================
# Nexo Short instance contract (ADR-001: the instance owns its identity)
# =====================================================================
# Hosts this app answers on. The short host serves redirects only
# (reputational fuse, ADR-001); the panel host serves landing/auth/panel.
NEXO_SHORT_HOST=nxo.test
NEXO_PANEL_HOST=nexoshort.test

# Auth mode: local | sso | both. Phase 1 implements `local` only (ADR-003).
NEXO_AUTH_MODE=local
# Self-hosters open/close local registration; hosted instance keeps it closed.
NEXO_ALLOW_REGISTRATION=true

# --- Nexo ID SSO (reusable client template). Off = standalone auth intact,
# --- no SSO routes. The callback lives on the PANEL host (needs a session). ---
NEXO_SSO_ENABLED=false
NEXO_SSO_ISSUER=https://nexoid.alvarocdev.com
NEXO_SSO_CLIENT_ID=
# Silent SSO (prompt=none) rides NEXO_SSO_ENABLED; set false to kill-switch it per tool.
NEXO_SSO_SILENT=true
NEXO_SSO_TIMEOUT=5
# Where Nexo ID returns the browser after a central (RP-initiated) logout. Register
# this exact URI on the provider or it lands on Nexo ID's own "signed out" page.
NEXO_SSO_POST_LOGOUT_REDIRECT_URI=https://nexoshort.alvarocdev.com

# Random slug length range (base62). ADR-005 / SPEC Phase 1.
NEXO_SLUG_MIN_LENGTH=6
NEXO_SLUG_MAX_LENGTH=7

# Attribution footer (multi-instance, add-branding-footer standard).
NEXO_ATTRIBUTION_ENABLED=true
# Short-host attribution (the minimal cookieless shell on nxo.li). Unset =
# the tool credits itself ("made with Nexo Short"); set your own for your instance.
# NEXO_ATTRIBUTION_TEXT="powered by yoursite.com"
# Canonical ecosystem powered-by label shown in the panel's nexo-footer.
# Attribution shown in the footer. Leave unset and the tool shows its own
# neutral default ("made with Nexo Short"). A third-party instance must NOT advertise
# the upstream author; set your own here.
# NEXO_ATTRIBUTION_LABEL="powered by yoursite.com"
# NEXO_ATTRIBUTION_URL="https://yoursite.com"

# --- Nexo ecosystem chrome (shared header/app-switcher/footer, panel host) ---
# Which tool this is (marks it current in the app-switcher).
NEXO_ECOSYSTEM_CURRENT=nexoshort
# Hub + developer entry points (env-overridable so self-hosters can repoint).
NEXO_HUB_URL=https://nexotools.alvarocdev.com
NEXO_GITHUB_ORG=https://github.com/nexo-tools
# Cookieless ecosystem analytics (opt-in, panel host only). Off by default; when
# true, an anonymous pageview beacon is sent to the Nexo Tools hub. See config/nexo.php.
NEXO_BEACON_ENABLED=false
# Help center contact (mailto: is used when no support URL is set).
NEXO_SUPPORT_URL=
NEXO_SUPPORT_EMAIL=hola@alvarocdev.com

# --- Anti-abuse (ADR-005) ---
# Creation and report rate limits (per minute).
NEXO_CREATE_RATE_PER_USER=10
NEXO_CREATE_RATE_PER_IP=20
NEXO_REPORT_RATE_PER_IP=5
# Google Safe Browsing Lookup API key. Empty = check disabled (self-host default).
# A flagged URL is always rejected; on API error, fail-open unless FAIL_CLOSED=true.
NEXO_SAFE_BROWSING_KEY=
NEXO_SAFE_BROWSING_FAIL_CLOSED=false

# Who runs this instance, named on the legal pages. Unset (default) = the
# "who runs this instance" section is not rendered, so a clone never publishes
# the upstream author's details. Alvaro's instances get these from CI.
# NEXO_LEGAL_OPERATOR="Your name or company"
# NEXO_LEGAL_CONTACT=legal@yourdomain.com
